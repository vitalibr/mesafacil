{
  "name": "mesafacil",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:dxf": "DXF_OUT=test-output/dxf vitest run src/export && python3 scripts/verify_dxf.py test-output/dxf",
    "check": "tsc -b && eslint . && vitest run && vite build"
  },
  "dependencies": {
    "@tarikjabiri/dxf": "2.8.9",
    "jszip": "^3.10.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.4.1",
    "dxf-parser": "^1.1.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^3.2.7"
  },
  "description": "Gerador gratuito de mesas de solda com exportação DXF para corte a laser.",
  "license": "MIT"
}
